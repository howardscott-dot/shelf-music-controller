# Use a LAN address that the WiiM itself can reach (not localhost).
JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_API_KEY=replace-with-a-dedicated-token
JELLYFIN_USER_ID=replace-with-user-id

# Optional established player. SHELF can now discover and remember compatible
# UPnP/DLNA renderers from its Output panel, so new installs may leave this blank.
# Keeping these values preserves a working WiiM installation during upgrades.
WIIM_HOST=192.168.1.20
WIIM_PORT=49152

# Optional Plex music library. The library ID can be omitted when Plex has one
# music section; SHELF will select it automatically.
PLEX_URL=
PLEX_TOKEN=
PLEX_MUSIC_LIBRARY_ID=

# Optional local/NAS music. Mount only the actual music folder (not the root of
# a large shared drive), preferably read-only, then point SHELF at that mount.
# Players fetch files from SHELF_PUBLIC_URL, which must be a LAN address they can
# resolve and reach (not localhost). The private index is saved in SHELF_DATA_DIR.
FILES_MUSIC_PATH=
SHELF_PUBLIC_URL=http://192.168.1.30:8787

PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Optional Spotify Premium integration. PKCE does not need a Client Secret.
# Register this exact redirect URI in the Spotify developer dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/api/spotify/callback
# Persistent private tokens and selected Spotify Connect device; never publish.
SHELF_DATA_DIR=.data
